{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "prisma:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "**/schema.prisma"],
      "outputs": ["node_modules/.prisma/client"]
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "api#build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**"],
      "env": ["*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["prisma:generate"]
    }
  }
}
