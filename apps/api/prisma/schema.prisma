generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// --- USER & AUTH ---

model User {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          Int     @default(3)
  isDelete      Boolean @default(false)
  isActive      Boolean @default(true)
  phone         String? @unique
  banned        Boolean @default(false)

  sessions Session[]
  accounts Account[]

  customerProfile CustomerProfile?

  products      Product[]      @relation("ProductCreatedBy")
  mediaUploaded MediaLibrary[] @relation("MediaUploadedBy")
  notifications Notification[]
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime

  userAgent String?
  ipAddress String?
  country   String?
  city      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model CustomerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId String? @unique
  loyaltyPoints    Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer_profile")
}

// --- MEDIA SYSTEM ---

model MediaLibrary {
  id               Int              @id @default(autoincrement())
  fileUrl          String
  title            String?
  fileName         String
  fileAlt          String?
  fileType         String?
  fileSize         Float?
  isDelete         Boolean          @default(false)
  publicId         String           @unique
  createdById      String?
  createdBy        User?            @relation("MediaUploadedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productMain      Product[]        @relation("MainImage")
  productSecondary Product[]        @relation("SecondaryImage")
  categoryImages   Category[]
  galleryItems     ProductGallery[]
  banners          Banner[]

  createdAt DateTime @default(now())

  @@map("media_library")
}

// --- PRODUCT SYSTEM ---

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  isDelete Boolean @default(false)

  imageId Int?
  image   MediaLibrary? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  products      Product[]
  subCategories SubCategory[]

  @@map("category")
}

model SubCategory {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  isDelete Boolean @default(false)

  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId Int?

  products Product[]
}

model Color {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  hex      String?
  variants ProductVariant[]

  @@map("color")
}

model Size {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  variants ProductVariant[]

  @@map("size")
}

model Product {
  id                    Int     @id @default(autoincrement())
  title                 String
  slug                  String  @unique
  description           String?
  shortDescription      String?
  additionalDescription String?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  basePrice     Float
  discountPrice Float?

  isNew    Boolean @default(false)
  isDelete Boolean @default(false)
  isActive Boolean @default(true)

  mainImageId Int?
  mainImage   MediaLibrary? @relation("MainImage", fields: [mainImageId], references: [id], onDelete: SetNull)

  secondaryImageId Int?
  secondaryImage   MediaLibrary? @relation("SecondaryImage", fields: [secondaryImageId], references: [id], onDelete: SetNull)

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  variants   ProductVariant[]
  gallery    ProductGallery[]
  orderItems OrderItem[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  subCategoryId Int?

  @@map("product")
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color   Color? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  colorId Int?

  size   Size? @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  sizeId Int?

  price    Float
  stock    Int     @default(0)
  isDelete Boolean @default(false)

  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId])
  @@map("product_variant")
}

model ProductGallery {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     MediaLibrary @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("product_gallery")
}

// --- ORDER SYSTEM ---

model Order {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  total         Float
  subtotal      Float
  status        Int     @default(0)
  paymentStatus Int     @default(0)
  isDelete      Boolean @default(false)

  customerProfileId String?
  customerProfile   CustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  name     String?
  region   String?
  city     String?
  district String?
  address  String?
  phone    String?
  email    String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("order")
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity Int
  price    Float

  color String?
  size  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_item")
}

// --- HISTORY & NOTIFICATIONS ---

model AuditLog {
  id     Int     @id @default(autoincrement())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action   Int
  entity   Int
  entityId String
  oldData  Json?
  newData  Json?

  createdAt DateTime @default(now())

  @@map("audit_log")
}

model Notification {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notification")
}

model Banner {
  id         Int     @id @default(autoincrement())
  title      String?
  subTitle   String?
  buttonText String?
  buttonLink String?

  mediaId Int
  media   MediaLibrary @relation(fields: [mediaId], references: [id])

  order    Int     @default(0)
  isActive Boolean @default(true)
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banner")
}

model PromoCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  title     String
  amount    Float
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_code")
}
