generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MODERATOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  INCOMPLETE
  PENDING
  PAID
  FAILED
  REFUNDED
}

// --- USER & AUTH ---

model User {
  id       Int      @id @default(autoincrement())
  name     String?
  email    String   @unique
  password String
  role     UserRole @default(CUSTOMER)
  isDelete Boolean  @default(false)
  isActive Boolean  @default(true)

  products      Product[]      @relation("ProductCreatedBy")
  mediaUploaded MediaLibrary[] @relation("MediaUploadedBy")
  notifications Notification[]
  auditLogs     AuditLog[]
  sessions      UserSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id           String   @id
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @db.Text
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model MediaLibrary {
  id               Int              @id @default(autoincrement())
  fileUrl          String
  fileName         String           @unique
  fileType         String?
  fileSize         Int?
  isDelete         Boolean          @default(false)
  createdById      Int?
  createdBy        User?            @relation("MediaUploadedBy", fields: [createdById], references: [id], onDelete: SetNull)
  productMain      Product[]        @relation("MainImage")
  productSecondary Product[]        @relation("SecondaryImage")
  categoryImages   Category[]
  galleryItems     ProductGallery[]
  banners          Banner[]

  createdAt DateTime @default(now())
}

// --- PRODUCT SYSTEM ---

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  isDelete Boolean @default(false)

  imageId Int?
  image   MediaLibrary? @relation(fields: [imageId], references: [id])

  products Product[]
}

model Color {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  hex      String?
  variants ProductVariant[]
}

model Size {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  variants ProductVariant[]
}

model Product {
  id                    Int     @id @default(autoincrement())
  title                 String
  slug                  String  @unique
  description           String?
  shortDescription      String?
  additionalDescription String?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  basePrice     Float
  discountPrice Float?

  isNew    Boolean @default(false)
  isDelete Boolean @default(false)
  isActive Boolean @default(true)

  mainImageId Int?
  mainImage   MediaLibrary? @relation("MainImage", fields: [mainImageId], references: [id])

  secondaryImageId Int?
  secondaryImage   MediaLibrary? @relation("SecondaryImage", fields: [secondaryImageId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdById Int?
  createdBy   User? @relation("ProductCreatedBy", fields: [createdById], references: [id])

  variants   ProductVariant[]
  gallery    ProductGallery[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  color   Color? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  colorId Int?

  size   Size? @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  sizeId Int?

  price    Float
  stock    Int     @default(0)
  isDelete Boolean @default(false)

  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId])
}

model ProductGallery {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     MediaLibrary @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// --- ORDER & LOGGING ---

model Order {
  id      Int    @id @default(autoincrement())
  orderId String @unique

  total         Float
  subtotal      Float
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(INCOMPLETE)
  isDelete      Boolean       @default(false)

  name     String?
  region   String?
  city     String?
  district String?
  address  String?
  phone    String?
  email    String?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int
  price    Float

  color String?
  size  String?
}

// --- HISTORY & NOTIFICATIONS ---

model AuditLog {
  id     Int   @id @default(autoincrement())
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  action   String
  entity   String
  entityId Int
  oldData  Json?
  newData  Json?

  createdAt DateTime @default(now())
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id         Int     @id @default(autoincrement())
  title      String?
  subTitle   String?
  buttonText String?
  buttonLink String?

  // Selection from Media Library
  mediaId Int
  media   MediaLibrary @relation(fields: [mediaId], references: [id])

  order    Int     @default(0)
  isActive Boolean @default(true)
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  title     String
  amount    Float
  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ForgotPassword {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  is_valid  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  email     String?

  @@map("forgot_passwords")
}
