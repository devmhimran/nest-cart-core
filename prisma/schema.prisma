generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
  MODERATOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  INCOMPLETE
  PENDING
  PAID
  FAILED
  REFUNDED
}

// --- USER & AUTH ---

model User {
  id       Int      @id @default(autoincrement())
  name     String?
  email    String   @unique
  password String
  role     UserRole @default(CUSTOMER)
  isDelete Boolean  @default(false)
  isActive Boolean  @default(true)

  products      Product[]      @relation("ProductCreatedBy")
  mediaUploaded MediaLibrary[] @relation("MediaUploadedBy")
  notifications Notification[]
  auditLogs     AuditLog[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- MEDIA LIBRARY (Upload first, then select) ---

model MediaLibrary {
  id       Int     @id @default(autoincrement())
  fileUrl  String
  fileName String  @unique
  fileType String? // e.g., "image/png"
  fileSize Int?
  isDelete Boolean @default(false)

  createdById Int?
  createdBy   User? @relation("MediaUploadedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Usage Relations
  productMain      Product[]        @relation("MainImage")
  productSecondary Product[]        @relation("SecondaryImage")
  categoryImages   Category[]
  galleryItems     ProductGallery[]

  // New: Banner relation
  banners Banner[]

  createdAt DateTime @default(now())
}

// --- PRODUCT SYSTEM ---

model Category {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  isDelete Boolean @default(false)

  imageId Int?
  image   MediaLibrary? @relation(fields: [imageId], references: [id])

  products Product[]
}

model Product {
  id          Int     @id @default(autoincrement())
  title       String
  slug        String  @unique
  description String?

  // Pricing
  basePrice     Float // Standard Price
  discountPrice Float? // Sale Price

  isDelete Boolean @default(false)
  isActive Boolean @default(true)

  // Media Selection
  mainImageId Int?
  mainImage   MediaLibrary? @relation("MainImage", fields: [mainImageId], references: [id])

  secondaryImageId Int?
  secondaryImage   MediaLibrary? @relation("SecondaryImage", fields: [secondaryImageId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdById Int?
  createdBy   User? @relation("ProductCreatedBy", fields: [createdById], references: [id])

  variants   ProductVariant[]
  gallery    ProductGallery[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String? // e.g. Small, Medium
  color String? // e.g. Blue, Red

  price    Float // Price specific to this variant
  stock    Int     @default(0)
  isDelete Boolean @default(false)

  orderItems OrderItem[]

  @@unique([productId, size, color])
}

model ProductGallery {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     MediaLibrary @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// --- ORDER & LOGGING ---

model Order {
  id            Int           @id @default(autoincrement())
  orderId       String        @unique // Readable ID like #ORD-1002
  total         Float
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(INCOMPLETE)
  isDelete      Boolean       @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int
  price    Float // Snapshot of price at time of purchase
}

// --- HISTORY & NOTIFICATIONS ---

model AuditLog {
  id     Int   @id @default(autoincrement())
  userId Int?
  user   User? @relation(fields: [userId], references: [id])

  action   String // e.g. "PRODUCT_UPDATE", "PRODUCT_CREATE"
  entity   String // e.g. "Product"
  entityId Int
  oldData  Json?
  newData  Json?

  createdAt DateTime @default(now())
}

model Notification {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Banner {
  id         Int     @id @default(autoincrement())
  title      String?
  subTitle   String?
  buttonText String?
  buttonLink String?

  // Selection from Media Library
  mediaId Int
  media   MediaLibrary @relation(fields: [mediaId], references: [id])

  order    Int     @default(0) // To sort the slider sequence
  isActive Boolean @default(true)
  isDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
